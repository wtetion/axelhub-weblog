const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=v=>{const n=Number(v||0);if(!Number.isFinite(n))return '0';for(const[u,d]of [['T',1e12],['B',1e9],['M',1e6],['K',1e3]])if(Math.abs(n)>=d)return (n/d).toFixed(2).replace(/\.00$/,'')+u;return Math.round(n).toLocaleString();};
const ago=iso=>{if(!iso)return '—';const sec=Math.max(0,Math.floor((Date.now()-new Date(iso).getTime())/1000));return sec<2?'now':sec<60?`${sec}s ago`:sec<3600?`${Math.floor(sec/60)}m ago`:`${Math.floor(sec/3600)}h ago`;};
const rarityColor=r=>({Titan:'#FF2D55',Divine:'#FF1493',Transcendent:'#FF1493',Superior:'#FF1493',Eternal:'#8B5CF6',Limited:'#F43F5E',Secret:'#7C3AED',Exotic:'#A855F7',Cosmic:'#06B6D4',Exclusive:'#14B8A6',Admin:'#EF4444',Mythic:'#EC4899',Mythical:'#EC4899',Prismatic:'#F59E0B',Rainbow:'#F59E0B','Squishy God':'#F59E0B',BrainrotGod:'#F59E0B',Legendary:'#FBBF24',Epic:'#A855F7',Rare:'#3B82F6',SuperRare:'#60A5FA',Celestial:'#22D3EE',Uncommon:'#22C55E',Basic:'#94A3B8',Common:'#9CA3AF',Unknown:'#6B7280'}[String(r||'Unknown')]||'#6B7280');
const safeColor=c=>/^#[0-9a-f]{6}$/i.test(String(c||''))?String(c):'#6B7280';
async function get(u){const r=await fetch(u,{cache:'no-store'});if(!r.ok)throw new Error(r.status);return r.json();}
function activityBadge(x){const a=String(x.activity||'Idle');const l=a.toLowerCase();let cls='idle';if(l.includes('steal'))cls='steal';else if(l.includes('tread'))cls='tread';else if(l.includes('hatch'))cls='hatch';else if(l.includes('sell'))cls='sell';else if(l.includes('plant'))cls='plant';else if(l.includes('return'))cls='return';else if(l.includes('hop'))cls='hop';return `<span class="activity-badge ${cls}">${esc(a)}</span>`;}
function eggImage(name){return `/api/egg-image?name=${encodeURIComponent(name||'')}`;}
async function refreshAll(){try{const a=await get('/api/accounts');$('players').textContent=a.players;$('servers').textContent=a.servers;$('joins').textContent=a.joins;const first=a.accounts.find(x=>x.live)||a.accounts[0]||{};$('currentActivity').textContent=first.activity||'Idle';$('currentActivityDetail').textContent=first.activityDetail||'waiting for telemetry';
$('accountRows').innerHTML=a.accounts.length?a.accounts.map(x=>`<tr><td><b>${esc(x.displayName)}</b><small>${esc(x.account)}</small></td><td><span class="device-badge ${String(x.device||'PC').toLowerCase()}"><i></i>${esc(x.device||'PC')}</span></td><td>${activityBadge(x)}<small>${esc(x.activityDetail||'')}</small></td><td><span class="event-pill">${'No Event'}</span></td><td>${esc(x.currentArea||x.latestStolenEgg?.area||'—')}</td><td>${fmt(x.money)}</td><td>${fmt(x.speed)}</td><td class="job-cell"><code class="job-id" title="${esc(x.jobId||'')}">${esc((x.jobId||'').slice(0,14))}${(x.jobId||'').length>14?'…':''}</code><button class="copy-job" type="button" data-job-id="${esc(x.jobId||'')}" title="Copy full Job ID" aria-label="Copy full Job ID">⧉</button></td><td><span class="${x.live?'live-text':'offline-text'}">${x.live?'LIVE':'OFFLINE'}</span> · ${ago(x.lastSeen)}</td></tr>`).join(''):'<tr><td colspan="9" class="empty">No accounts yet — send telemetry.</td></tr>';
$('activityList').innerHTML=a.accounts.length?a.accounts.slice(0,20).map(x=>`<div class="activity-item"><div class="activity-main"><div class="activity-top"><b>${esc(x.displayName||x.account)}</b>${activityBadge(x)}<span class="area-chip">${esc(x.currentArea||'No area')}</span></div><p>${esc(x.activityDetail||'Idle')}</p><div class="event-line">Event <strong>${'No Event'}</strong></div></div><div class="activity-right"><span>${ago(x.lastSeen)}</span><small>${x.live?'● LIVE':'● OFFLINE'}</small></div></div>`).join(''):'<div class="empty">No active accounts.</div>';
const inv=await get('/api/inventory');$('inventoryGrid').innerHTML=inv.accounts.length?inv.accounts.map(x=>{const pct=x.eggCapacity?Math.min(100,x.eggInventory/x.eggCapacity*100):0;const items=x.eggItems||[];const last=x.latestStolenEgg;return `<article class="inventory-card"><div class="inventory-title"><div><b>${esc(x.displayName||x.account)}</b><small>${activityBadge(x)} <span class="device-mini">${esc(x.device||'PC')}</span> ${esc(x.currentArea||'')}</small></div><span class="${x.live?'live-text':'offline-text'}">${x.live?'● LIVE':'● OFFLINE'}</span></div><div class="inventory-summary"><div><span>EGGS</span><b>${fmt(x.eggInventory)} / ${fmt(x.eggCapacity)}</b></div><div><span>STOLEN</span><b>${fmt(x.eggsStolen)}</b></div><div><span>EVENT</span><b>${'No Event'}</b></div></div><div class="meter"><i style="width:${pct}%"></i></div><div class="egg-grid">${items.length?items.map(it=>{const c=safeColor(it.rarityColor||rarityColor(it.rarity));return `<div class="egg-card" style="--rarity:${c}"><div class="egg-image"><img loading="lazy" src="${eggImage(it.name)}" onerror="this.onerror=null;this.src='/assets/egg-fallback.svg'"><span>x${fmt(it.count)}</span></div><b>${esc(it.name)}</b><small style="color:${c}">${esc(it.rarity)}</small>${it.mutation&&it.mutation!=='Normal'?`<em>${esc(it.mutation)}</em>`:''}</div>`}).join(''):'<div class="empty small">No eggs found.</div>'}</div>${last?`<div class="latest-stolen" style="--rarity:${safeColor(last.rarityColor||rarityColor(last.rarity))}"><img src="${eggImage(last.name)}" onerror="this.onerror=null;this.src='/assets/egg-fallback.svg'"><div><span>LAST STOLEN</span><b>${esc(last.name)}</b><strong>${esc(last.rarity)}</strong><small>${esc(last.area||'Unknown area')}</small></div></div>`:''}</article>`}).join(''):'<div class="empty">No inventory data yet.</div>';
const an=await get('/api/analytics');$('aStolen').textContent=fmt(an.totalEggsStolen);$('aEggInventory').textContent=fmt(an.totalEggInventory);$('aActivity').textContent=an.currentActivity||'Idle';$('aActivityDetail').textContent=an.currentActivityDetail||an.currentEvent||'No active report';$('aArea').textContent=an.currentArea||'—';
const ev=await get('/api/events');$('eventsList').innerHTML=ev.events.length?ev.events.slice(0,80).map(e=>{const egg=e.latestStolenEgg;const c=safeColor(egg?.rarityColor||rarityColor(egg?.rarity));return `<div class="event-row" style="--rarity:${c}"><div class="rarity-bar"></div><div class="event-content"><div class="event-title"><b>${esc(e.displayName||e.account)}</b><span>•</span>${activityBadge(e)}</div><div class="event-meta-line"><span>Event: <strong>${'No Event'}</strong></span><span>Area: <strong>${esc(e.currentArea||egg?.area||'—')}</strong></span></div>${egg?`<div class="stolen"><img src="${eggImage(egg.name)}" onerror="this.onerror=null;this.src='/assets/egg-fallback.svg'"><div><b>${esc(egg.name)}</b><span style="color:${c}">${esc(egg.rarity)}</span>${egg.mutation&&egg.mutation!=='Normal'?`<em>${esc(egg.mutation)}</em>`:''}</div></div>`:''}</div><div class="event-time"><b>${esc(e.live?'LIVE':'')}</b><span>${ago(e.createdAt)}</span></div></div>`}).join(''):'<div class="empty">No events yet.</div>';}catch(e){console.warn('refresh',e);}}
function updateClock(){const parts=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Bangkok',hour:'2-digit',minute:'2-digit',hour12:true}).format(new Date()).split(' ');$('clock').textContent=parts[0]||'--:--';$('clockAmpm').textContent=parts[1]||'--';}
updateClock();setInterval(updateClock,1000);
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id===b.dataset.tab));}));
$('refresh').addEventListener('click',refreshAll);document.addEventListener('click',async e=>{const b=e.target.closest('.copy-job');if(!b)return;const id=b.dataset.jobId||'';try{await navigator.clipboard.writeText(id);b.textContent='✓';setTimeout(()=>b.textContent='⧉',900);}catch(err){const ta=document.createElement('textarea');ta.value=id;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');b.textContent='✓';setTimeout(()=>b.textContent='⧉',900);}finally{ta.remove();}}});const stream=new EventSource('/api/stream');stream.onmessage=()=>refreshAll();refreshAll();setInterval(refreshAll,10000);
// Inspired by the supplied glassmorphism source: animated radial ambient field with mouse parallax.
const canvas=$('bg-canvas'),ctx=canvas.getContext('2d');let w=0,h=0,mx=.5,my=.5,t=0;function resize(){w=canvas.width=innerWidth;h=canvas.height=innerHeight;}addEventListener('resize',resize);addEventListener('mousemove',e=>{mx=e.clientX/innerWidth;my=e.clientY/innerHeight;});resize();function render(){t+=.004;const gx=w*(.25+mx*.3),gy=h*(.18+my*.3);const g=ctx.createRadialGradient(gx,gy,20,w*.5,h*.5,Math.max(w,h)*.85);g.addColorStop(0,'rgba(255,210,82,.08)');g.addColorStop(.45,'rgba(255,53,72,.025)');g.addColorStop(1,'rgba(2,3,5,0)');ctx.fillStyle='#020305';ctx.fillRect(0,0,w,h);ctx.fillStyle=g;ctx.fillRect(0,0,w,h);for(let i=0;i<26;i++){const a=t+i*.7;const x=w*(.5+.38*Math.cos(a*.21+i));const y=h*(.5+.38*Math.sin(a*.17+i*1.7));ctx.beginPath();ctx.arc(x,y,1.2+(i%3),0,Math.PI*2);ctx.fillStyle=`rgba(255,196,65,${.03+(i%4)*.015})`;ctx.fill();}requestAnimationFrame(render);}render();
