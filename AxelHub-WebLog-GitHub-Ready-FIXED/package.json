{
  "name": "axelhub-weblog-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --assets ./public",
    "db:create": "wrangler d1 create axelhub-weblog",
    "db:migrate:local": "wrangler d1 migrations apply axelhub-weblog --local",
    "db:migrate:remote": "wrangler d1 migrations apply axelhub-weblog --remote"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
